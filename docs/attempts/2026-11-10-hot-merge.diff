   ctx = main
   local pc = main and main.cfg and main.cfg.pool or {}
   growStep = pc.growStep or 16
+  M.hotOn = pc.hotMerge == true
   TILE_CLASSES = max(1, floor(pc.tileClasses or 24))
   DEC_MIN_CORNERS = pow2(max(24, pc.decalMinCorners or 96), 24)
 end
