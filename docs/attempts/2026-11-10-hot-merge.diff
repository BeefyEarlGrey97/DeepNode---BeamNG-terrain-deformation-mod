+-------------------------------------------------------------------------------
+-- hot groups (pool.hotMerge)
+-------------------------------------------------------------------------------
+-- The engine charges the shadow pass (+0.75 ms on the upload frame) and 0.36 ms of
+-- createMesh per CALL; a submesh costs 0.46 ms (256 vertices; measured 2026-11-10, gridmap_v2,
+-- dntestEng cases k<N> / m<N>). Two trucks made ~100 calls per second, 2.2 per vehicle report.
+-- So the tiles one vehicle is digging upload together, as submeshes of one object per vehicle
+-- (the group). A grouped tile holds a proxy table in t.obj (no engine object) and keeps its
+-- last meshes in its own pair of builders. It gets its own object back, with the same mesh,
+-- in the frame the group uploads without it after it missed more than HOT_MISS group uploads
+-- (measured, 2 Urals: a tile that skips an upload changes again at the next one in 219 of
+-- 310 cases, else mostly after 10 and more: carry it once, 0.46 ms, then split, one call), or
+-- one tile per frame once the group has not uploaded for HOT_IDLE s. Same vertices on screen;
+-- a tile that rides along with its group is only ever updated earlier than on its own.
+local HOT_MISS, HOT_IDLE = 1, 0.25
+-- Engine memory grows when an object gets other buffer sizes than its last mesh (see the
+-- size classes above), and a group's size signature is the combination of its tiles' sizes:
+-- with the 24 tile classes in member order nearly every group upload had a new signature
+-- (+205 MB in a 20 s run, 2 Urals; +2 MB with one object per tile). So a group pads all its
+-- tiles to one of HOT_CLASSES sizes, the class of its biggest tile (padMeshes): a signature
+-- is just (tiles, class).
+local HOT_CLASSES = 8
+local hot = {} -- gid -> { gid, N, members = {proxy}, ghosts = {tile}, obj, spare, dirty, last }
+local freeBuilders = {}
+local Proxy = {}
+Proxy.__index = Proxy
+function Proxy.setHidden() end
+function Proxy.isHidden() return false end
+M.hotOn = false
+M.hotMiss = HOT_MISS
+-- fresh = tiles that changed in a group upload (the rest were carried); gaps[n] = times a
+-- tile changed again after n group uploads without a change
+M.hotStats = { uploads = 0, subs = 0, joins = 0, splits = 0, fresh = 0, gaps = {} }
+
+local function takeBuilder() return table.remove(freeBuilders) or M.newBuilder() end
+
+local function hotRemove(px)
+  local ms = px.grp.members
+  for i = 1, #ms do if ms[i] == px then table.remove(ms, i); break end end
+  px.grp = nil
+end
+
+local function hotFree(px)
+  if px.b then freeBuilders[#freeBuilders + 1] = px.b end
+  if px.back then freeBuilders[#freeBuilders + 1] = px.back end
+  px.b, px.back, px.meshes = nil, nil, nil
+end
+
+-- the tile gave up its mesh (deferRelease / release of its proxy)
+hotLeave = function(px)
+  local G = px.grp
+  if not G then return end
+  hotRemove(px)
+  if px.old then deferRelease(px.old); px.old = nil end
+  hotFree(px)
+  G.dirty = true -- the group uploads without it (or goes) at the next flush
+end
+
+-- the tile gets its own object back, with the mesh the group shows for it
+local function hotSplit(px)
+  local G, t = px.grp, px.tile
+  hotRemove(px)
+  if t.obj == px then
+    t.obj = nil
+    if px.meshes and uploadChunk(t, px.meshes) then
+      -- the group object draws the same mesh until its next upload
+      t.hotGhost = G
+      G.ghosts[#G.ghosts + 1] = t
+    else
+      t.dirty, t.geoN = true, nil -- no object to be had: its own rebuild brings it back
+    end
+  end
+  if px.old then deferRelease(px.old); px.old = nil end
+  hotFree(px)
+  M.hotStats.splits = M.hotStats.splits + 1
+end
+
+local function hotClearGhosts(G)
+  local gs = G.ghosts
+  for i = #gs, 1, -1 do
+    if gs[i].hotGhost == G then gs[i].hotGhost = nil end
+    gs[i] = nil
+  end
+end
+
+local function hotRetire(G)
+  if G.obj then deferRelease(G.obj); G.obj = nil end
+  M.dropSpare(G)
+  hotClearGhosts(G)
+  if hot[G.gid] == G then hot[G.gid] = nil end
+end
+
+-- before a tile's mesh object goes somewhere else (sector handover, frozen own mesh)
+function M.hotSettle(t)
+  local px = t.obj
+  if type(px) ~= 'table' or not px.grp then return end
+  local G = px.grp
+  hotSplit(px)
+  G.dirty = true
+end
+
+hotPresent = function(t, meshes, gid)
+  local px = type(t.obj) == 'table' and t.obj or nil
+  if meshes ~= lastTileMeshes or lastTileBuilder ~= (px and px.back or sharedBuilder) then
+    -- not this tile's last build (its arrays cannot be kept): plain upload
+    if px then M.hotSettle(t) end
+    if not uploadChunk(t, meshes) then return false end
+    stats.builds = stats.builds + 1
+    return true
+  end
+  lastTileMeshes = nil
+  if px then
+    px.b, px.back = px.back, px.b
+  else
+    local G = hot[gid]
+    if not G then
+      G = { gid = gid, N = t.N, classes = HOT_CLASSES, members = {}, ghosts = {}, subs = {}, last = 0 }
+      hot[gid] = G
+    end
+    -- the tile takes the shared builder (it holds this build); its old object stays shown
+    -- until the group has uploaded
+    px = setmetatable({ tile = t, grp = G, old = t.obj, b = sharedBuilder, back = takeBuilder() }, Proxy)
+    sharedBuilder = takeBuilder()
+    G.members[#G.members + 1] = px
+    M.dropSpare(t)
+    t.obj = px
+    M.hotStats.joins = M.hotStats.joins + 1
+  end
+  px.meshes, px.fresh = meshes, true
+  px.miss = px.miss or 0
+  px.grp.dirty = true
+  -- another group still draws this tile's older mesh
+  if t.hotGhost and t.hotGhost ~= px.grp then t.hotGhost.dirty = true end
+  local nv = 0
+  for i = 1, #meshes do nv = nv + #meshes[i].verts end
+  t.lastVerts = nv
+  stats.builds = stats.builds + 1
+  return true
+end
+
+-- a tile of this group is about to be presented: other dirty tiles of the group can ride along
+function M.hotGo(t, gid)
+  local px = t.obj
+  local G = type(px) == 'table' and px.grp or (M.hotOn and gid and hot[gid]) or nil
+  if G then G.goFrame = frameNo end
+end
+function M.hotGoing(t)
+  local px = t.obj
+  return type(px) == 'table' and px.grp ~= nil and px.grp.goFrame == frameNo
+end
+
+-- Once per frame, after the tile rebuilds: one createMesh per group that changed.
+function M.flushHot(now)
+  for _, G in pairs(hot) do
+    local ms = G.members
+    if G.dirty then
+      for i = #ms, 1, -1 do
+        local px = ms[i]
+        if px.fresh then
+          local hs = M.hotStats
+          hs.fresh = hs.fresh + 1
+          if px.miss > 0 then hs.gaps[px.miss] = (hs.gaps[px.miss] or 0) + 1 end
+          px.fresh, px.miss = false, 0
+        else
+          px.miss = px.miss + 1
+          if px.miss > M.hotMiss then hotSplit(px) end
+        end
+      end
+      if #ms == 0 then
+        hotRetire(G)
+      else
+        local subs, n = G.subs, 0
+        for i = 1, #ms do
+          local m = ms[i].meshes
+          for k = 1, #m do n = n + 1; subs[n] = m[k] end
+        end
+        for k = #subs, n + 1, -1 do subs[k] = nil end
+        if uploadChunk(G, subs) then
+          G.dirty, G.last = false, now
+          for i = 1, #ms do
+            local px = ms[i]
+            if px.old then deferRelease(px.old); px.old = nil end
+          end
+          hotClearGhosts(G)
+          M.hotStats.uploads = M.hotStats.uploads + 1
+          M.hotStats.subs = M.hotStats.subs + n
+        end
+      end
+    elseif #ms == 0 then
+      hotRetire(G)
+    elseif now - G.last > HOT_IDLE then
+      hotSplit(ms[#ms])
+      if #ms == 0 then hotRetire(G) end
+    end
+  end
+end
+
+function M.hotReset()
+  hot = {}
+  lastTileMeshes, lastTileBuilder = nil, nil
 end
 
